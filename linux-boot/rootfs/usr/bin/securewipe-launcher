#!/bin/bash
# SecureWipe Launcher - Main application for secure data wiping
# This script provides the main interface for the SecureWipe application

set -e

# Import all wiping engines
source /usr/lib/securewipe/wipe-engine.sh
source /usr/lib/securewipe/crypto-erase.sh
source /usr/lib/securewipe/hdd-overwrite.sh
source /usr/lib/securewipe/external-storage.sh
source /usr/lib/securewipe/verification.sh
source /usr/lib/securewipe/certificate-gen.sh

# Configuration
SECUREWIPE_VERSION="1.0.0"
LOG_FILE="/var/log/securewipe/launcher.log"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Logging function
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
    echo -e "$1"
}

# Initialize application
initialize_securewipe() {
    clear
    
    # Create necessary directories
    mkdir -p "$(dirname "$LOG_FILE")"
    mkdir -p "$CERTIFICATE_DIR"
    
    # Start logging
    log_message "INFO" "SecureWipe v$SECUREWIPE_VERSION starting..."
    log_message "INFO" "Bootable environment initialization"
    
    # Display header
    echo -e "${WHITE}"
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║                    SecureWipe v$SECUREWIPE_VERSION                         ║"
    echo "║              Secure Data Sanitization System                  ║"
    echo "║                                                                ║"
    echo "║   🔒 Tamper-proof wiping with digital certificates 🔒         ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    echo ""
    
    log_message "INFO" "Application initialized successfully"
}

# Detect storage devices
detect_storage_devices() {
    log_message "INFO" "Starting storage device detection..."
    
    echo -e "${YELLOW}Detecting storage devices...${NC}"
    
    # Clear previous device list
    > "$DEVICE_LIST_FILE"
    
    # Detect block devices
    local device_count=0
    
    for device in /dev/sd* /dev/nvme*n* /dev/mmc*; do
        if [ -b "$device" ] && [ "$device" != "/dev/sd*" ] && [ "$device" != "/dev/nvme*n*" ] && [ "$device" != "/dev/mmc*" ]; then
            # Get device information
            local size=$(blockdev --getsize64 "$device" 2>/dev/null || echo "0")
            local size_human=$(numfmt --to=iec-i --suffix=B "$size" 2>/dev/null || echo "Unknown")
            local model=$(lsblk -no MODEL "$device" 2>/dev/null | head -1 | tr -d ' ' || echo "Unknown")
            local serial=$(lsblk -no SERIAL "$device" 2>/dev/null | head -1 || echo "Unknown")
            
            # Only include devices larger than 1MB (to filter out invalid devices)
            if [ "$size" -gt 1048576 ]; then
                device_count=$((device_count + 1))
                echo "$device_count:$device:$size_human:$model:$serial" >> "$DEVICE_LIST_FILE"
                log_message "INFO" "Detected device: $device ($size_human, $model)"
            fi
        fi
    done
    
    log_message "INFO" "Storage detection complete. Found $device_count devices."
    return $device_count
}

# Display device selection menu
show_device_menu() {
    local device_count=$1
    
    if [ "$device_count" -eq 0 ]; then
        echo -e "${RED}❌ No storage devices detected!${NC}"
        echo ""
        echo "This could mean:"
        echo "• No USB drives or storage devices are connected"
        echo "• Devices need additional drivers not included in this environment"
        echo "• Hardware compatibility issue"
        echo ""
        echo "Please connect a storage device and restart SecureWipe."
        log_message "ERROR" "No storage devices found"
        read -p "Press Enter to exit..." 
        exit 1
    fi
    
    echo -e "${GREEN}✅ Found $device_count storage device(s):${NC}"
    echo ""
    
    # Display device list
    local counter=1
    while IFS=':' read -r num device size model serial; do
        echo -e "${WHITE}[$counter]${NC} $device"
        echo "    Size: $size"
        echo "    Model: $model"  
        echo "    Serial: $serial"
        echo ""
        counter=$((counter + 1))
    done < "$DEVICE_LIST_FILE"
    
    echo -e "${RED}⚠️  WARNING: SECURE WIPE WILL PERMANENTLY DESTROY ALL DATA!${NC}"
    echo -e "${RED}    This action cannot be undone!${NC}"
    echo ""
}

# Get user device selection
get_device_selection() {
    local device_count=$1
    local selection
    
    while true; do
        echo -e "${YELLOW}Select device to securely wipe [1-$device_count], or 'q' to quit:${NC}"
        read -r selection
        
        if [ "$selection" = "q" ] || [ "$selection" = "Q" ]; then
            echo "SecureWipe cancelled by user."
            log_message "INFO" "Operation cancelled by user"
            exit 0
        fi
        
        # Validate numeric input
        if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le "$device_count" ]; then
            # Get selected device path
            selected_device=$(awk -F: -v sel="$selection" '$1 == sel {print $2}' "$DEVICE_LIST_FILE")
            selected_device_info=$(awk -F: -v sel="$selection" '$1 == sel {print $2 " (" $3 ", " $4 ")"}' "$DEVICE_LIST_FILE")
            
            log_message "INFO" "User selected device: $selected_device_info"
            return 0
        else
            echo -e "${RED}Invalid selection. Please enter a number between 1 and $device_count.${NC}"
        fi
    done
}

# Confirm wipe operation
confirm_wipe_operation() {
    echo ""
    echo -e "${RED}╔═══════════════════════════════════════════╗${NC}"
    echo -e "${RED}║           FINAL CONFIRMATION             ║${NC}"
    echo -e "${RED}╚═══════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${WHITE}Selected device: $selected_device_info${NC}"
    echo ""
    echo -e "${RED}This will PERMANENTLY ERASE all data on this device!${NC}"
    echo -e "${RED}This action CANNOT be undone!${NC}"
    echo ""
    echo "Type 'CONFIRM' (in uppercase) to proceed with secure wipe:"
    
    local confirmation
    read -r confirmation
    
    if [ "$confirmation" = "CONFIRM" ]; then
        log_message "INFO" "Wipe operation confirmed by user for device: $selected_device"
        return 0
    else
        echo "Operation cancelled - confirmation not received."
        log_message "INFO" "Wipe operation cancelled - invalid confirmation"
        exit 0
    fi
}

# Main application flow
main() {
    initialize_securewipe
    
    # Hardware detection
    detect_storage_devices
    device_count=$?
    
    # Device selection
    show_device_menu $device_count
    get_device_selection $device_count
    confirm_wipe_operation
    
    # TODO: Implement actual wiping logic in next phase
    echo ""
    echo -e "${GREEN}✅ SecureWipe setup complete!${NC}"
    echo "Selected device: $selected_device_info"
    echo ""
    echo "🚧 Wiping engine implementation coming in next phase..."
    log_message "INFO" "SecureWipe launcher completed successfully"
    
    read -p "Press Enter to continue..."
}

# Run main application
main "$@"